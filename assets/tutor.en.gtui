  "texts": [
    {
      "id": "t0_welcome",
      "text": "A tutorial copy: edit anything, nothing is written back.\n:q leaves it; run `graph-tui tutor` again to start over.\nFirst: Ctrl-d goes one chapter down, Ctrl-u comes back.\nThe cursor is on this line; tap h j k l and watch it move.",
      "at": [
        1,
        1
      ],
      "box": "c0_welcome",
      "color": null,
      "bg": null,
      "align": "left",
      "layer": ""
    },
    {
      "id": "t1_move",
      "text": "The cursor moves by cell, not by box: one cell at a time.\nh j k l move one cell; 5l moves five.\nCtrl-d / Ctrl-u jump half a screen; use them for distance.\nSpace brings the cursor box to the middle.\nWhen you are done, Ctrl-d for the next chapter.",
      "at": [
        1,
        11
      ],
      "box": "c1_move",
      "color": null,
      "bg": null,
      "align": "left",
      "layer": ""
    },
    {
      "id": "t2_find",
      "text": "Press / and type a few letters; matches turn yellow.\nEnter closes the search; n / N step through the matches.\nCtrl-o / Ctrl-i go back / forward through your stops.\nw / b jump too: the first box or edge stops them.\nPress n once, then Ctrl-d to keep going.",
      "at": [
        1,
        22
      ],
      "box": "c2_find",
      "color": null,
      "bg": null,
      "align": "left",
      "layer": ""
    },
    {
      "id": "t3_view",
      "text": "+ / - zoom, 0 goes back to 1:1 (the picture does not jump).\nf fits the cursor's group, F fits the whole picture.\nE isolates: this node and its neighbours; E or Esc restores.\nFar out it turns into blocks (LOD); zoom in to recover.\nPress + twice, then 0: learn the feel.",
      "at": [
        1,
        33
      ],
      "box": "c3_view",
      "color": null,
      "bg": null,
      "align": "left",
      "layer": ""
    },
    {
      "id": "t4_edit",
      "text": "i edits this box in place; the caret is the insert point.\nEnter breaks the line (the box grows); Esc commits it.\nu undoes; Ctrl-r redoes.\nCtrl-G hands the text to $EDITOR.\nDo it once: i, change a letter, Esc, u.",
      "at": [
        1,
        44
      ],
      "box": "c4_edit",
      "color": null,
      "bg": null,
      "align": "left",
      "layer": ""
    },
    {
      "id": "t5_build",
      "text": "i elsewhere creates a box and starts typing.\ne starts a link: click the target box, Enter confirms.\nv drags a selection; y copies, d cuts, p pastes.\nCounts work as usual: 5l, 5p.\nGo down to the sandbox and connect the two boxes.",
      "at": [
        1,
        55
      ],
      "box": "c5_build",
      "color": null,
      "bg": null,
      "align": "left",
      "layer": ""
    },
    {
      "id": "t6_style",
      "text": "s opens the style menu: style, colour, fill, align.\nc changes colour only (border for a box, ink for an edge).\n:box double and :edgecolor #ff8800 work too.\nUse s to turn the empty box into double.\nCtrl-d when you are finished.",
      "at": [
        1,
        66
      ],
      "box": "c6_style",
      "color": null,
      "bg": null,
      "align": "left",
      "layer": ""
    },
    {
      "id": "t7_files",
      "text": ":w saves, :w path saves elsewhere, :e path opens a file.\nCtrl-t new tab, Ctrl-n / Ctrl-p switch, Ctrl-w closes.\n:q quits; unsaved changes make it ask first.\nNo need to save: quit and rerun the command to reset.\nThat is all: :q, and come back whenever.",
      "at": [
        1,
        77
      ],
      "box": "c7_files",
      "color": null,
      "bg": null,
      "align": "left",
      "layer": ""
    },
    {
      "id": "t_label",
      "text": "sandbox: change anything, nothing is saved",
      "at": [
        0,
        88
      ],
      "box": "s_label",
      "color": null,
      "bg": null,
      "align": "left",
      "layer": ""
    },
    {
      "id": "t_edit",
      "text": "change foo to bar",
      "at": [
        1,
        92
      ],
      "box": "s_edit",
      "color": null,
      "bg": null,
      "align": "left",
      "layer": ""
    },
