// Elisa 音乐播放器(本机装的真实程序)的数据库外键图:
//   /home/mix/.local/share/elisa/elisaDatabase.db
// 重算:sqlite3 读每张表的 pragma foreign_key_list.
// 12 张表 8 条外键,写代码前先看它长什么样.
digraph schema {
  node [shape=box];
  "Albums";
  "Artists";
  "Composer";
  "DatabaseVersion";
  "DatabaseVersionV15";
  "DiscoverSource";
  "Genre";
  "Lyricist";
  "Radios";
  "Tracks";
  "TracksData";
  "sqlite_sequence";
  edge [group="fk", color="#22b46a"];
  "Albums" -> "Artists";
  "Radios" -> "Genre";
  "Tracks" -> "Albums";
  "Tracks" -> "Genre";
  "Tracks" -> "Lyricist";
  "Tracks" -> "Composer";
  "Tracks" -> "Artists";
  "Tracks" -> "TracksData";
}
