  "legend": {
    "title": "转移",
    "entries": [
      {
        "text": "CLOSED -> LISTEN      被动打开",
        "group": "g0",
        "color": null,
        "glyph": null
      },
      {
        "text": "CLOSED -> SYN-SENT    主动打开",
        "group": "g0",
        "color": null,
        "glyph": null
      },
      {
        "text": "LISTEN -> SYN-RECEIVED  收到 SYN",
        "group": "g0",
        "color": null,
        "glyph": null
      },
      {
        "text": "SYN-SENT -> ESTABLISHED  收到 SYN+ACK",
        "group": "g0",
        "color": null,
        "glyph": null
      },
      {
        "text": "SYN-RECEIVED -> LISTEN  收到 RST(被动)",
        "group": "g0",
        "color": null,
        "glyph": null
      },
      {
        "text": "ESTABLISHED -> FIN-WAIT-1  close",
        "group": "g1",
        "color": null,
        "glyph": null
      },
      {
        "text": "FIN-WAIT-1 -> CLOSING  收到 FIN",
        "group": "g1",
        "color": null,
        "glyph": null
      },
      {
        "text": "TIME-WAIT -> CLOSED    等够 2MSL",
        "group": "g1",
        "color": null,
        "glyph": null
      },
      {
        "text": "ESTABLISHED -> CLOSE-WAIT  收到 FIN",
        "group": "g2",
        "color": null,
        "glyph": null
      },
      {
        "text": "LAST-ACK -> CLOSED     收到 ACK",
        "group": "g2",
        "color": null,
        "glyph": null
      },
      {
        "text": "FIN-WAIT-1 <-> CLOSE-WAIT  两个角色",
        "group": "g3",
        "color": null,
        "glyph": "dashed"
      },
      {
        "text": "SYN-SENT -> SYN-SENT   重传 SYN",
        "group": "g4",
        "color": null,
        "glyph": "dashed"
      },
      {
        "text": "SYN-RECEIVED -> SYN-RECEIVED   重传 SYN+ACK",
        "group": "g4",
        "color": null,
        "glyph": "dashed"
      },
      {
        "text": "ESTABLISHED -> ESTABLISHED   重传数据",
        "group": "g4",
        "color": null,
        "glyph": "dashed"
      },
      {
        "text": "FIN-WAIT-1 -> FIN-WAIT-1   重传 FIN",
        "group": "g4",
        "color": null,
        "glyph": "dashed"
      },
      {
        "text": "CLOSING -> CLOSING   重传 FIN",
        "group": "g4",
        "color": null,
        "glyph": "dashed"
      },
      {
        "text": "LAST-ACK -> LAST-ACK   重传 FIN+ACK",
        "group": "g4",
        "color": null,
        "glyph": "dashed"
      },
      {
        "text": "TIME-WAIT -> TIME-WAIT   再等 2MSL",
        "group": "g4",
        "color": null,
        "glyph": "dashed"
      }
    ]
  }
}
