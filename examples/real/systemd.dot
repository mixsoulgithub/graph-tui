// 本机真实的服务依赖:dbus.socket 那一圈 21 个单元.
// 重算:systemctl list-dependencies --reverse dbus.socket 取单元名单,
//       再对每个单元读 systemctl show -p Requires -p Wants -p After.
// 边是 systemctl show 读出来的 Requires(硬依赖)/ Wants(软依赖)/ After(只讲顺序)。
digraph systemd {
  node [shape=box];
  "dbus.socket";
  "accounts-daemon.service";
  "avahi-daemon.service";
  "bluetooth.service";
  "colord.service";
  "cpupower-gui-helper.service";
  "dbus.service";
  "fwupd.service";
  "ModemManager.service";
  "NetworkManager.service";
  "power-profiles-daemon.service";
  "rtkit-daemon.service";
  "switcheroo-control.service";
  "systemd-logind.service";
  "udisks2.service";
  "upower.service";
  "wpa_supplicant.service";
  "sockets.target";
  "basic.target";
  "multi-user.target";
  "graphical.target";
  edge [group="requires", color="#ef4b4b"];
  "ModemManager.service" -> "dbus.socket";
  "NetworkManager.service" -> "dbus.service";
  "NetworkManager.service" -> "dbus.socket";
  "accounts-daemon.service" -> "dbus.socket";
  "avahi-daemon.service" -> "dbus.socket";
  "bluetooth.service" -> "dbus.socket";
  "colord.service" -> "dbus.socket";
  "cpupower-gui-helper.service" -> "dbus.socket";
  "dbus.service" -> "dbus.socket";
  "fwupd.service" -> "dbus.socket";
  "graphical.target" -> "multi-user.target";
  "multi-user.target" -> "basic.target";
  "power-profiles-daemon.service" -> "dbus.socket";
  "rtkit-daemon.service" -> "dbus.socket";
  "switcheroo-control.service" -> "dbus.socket";
  "udisks2.service" -> "dbus.socket";
  "upower.service" -> "dbus.socket";
  "wpa_supplicant.service" -> "dbus.socket";
  edge [group="wants", color="#4c8ef8"];
  "basic.target" -> "sockets.target";
  "graphical.target" -> "accounts-daemon.service";
  "graphical.target" -> "power-profiles-daemon.service";
  "graphical.target" -> "switcheroo-control.service";
  "graphical.target" -> "udisks2.service";
  "multi-user.target" -> "ModemManager.service";
  "multi-user.target" -> "NetworkManager.service";
  "multi-user.target" -> "avahi-daemon.service";
  "multi-user.target" -> "dbus.service";
  "multi-user.target" -> "systemd-logind.service";
  "multi-user.target" -> "wpa_supplicant.service";
  "sockets.target" -> "dbus.socket";
  "systemd-logind.service" -> "dbus.socket";
  edge [group="after", color="#78909c"];
  "ModemManager.service" -> "basic.target";
  "NetworkManager.service" -> "basic.target";
  "accounts-daemon.service" -> "basic.target";
  "avahi-daemon.service" -> "basic.target";
  "bluetooth.service" -> "basic.target";
  "colord.service" -> "basic.target";
  "cpupower-gui-helper.service" -> "basic.target";
  "dbus.service" -> "basic.target";
  "fwupd.service" -> "basic.target";
  "fwupd.service" -> "dbus.service";
  "multi-user.target" -> "switcheroo-control.service";
  "power-profiles-daemon.service" -> "basic.target";
  "power-profiles-daemon.service" -> "multi-user.target";
  "rtkit-daemon.service" -> "basic.target";
  "switcheroo-control.service" -> "basic.target";
  "systemd-logind.service" -> "basic.target";
  "udisks2.service" -> "basic.target";
  "upower.service" -> "basic.target";
  "wpa_supplicant.service" -> "basic.target";
  "wpa_supplicant.service" -> "dbus.service";
}
