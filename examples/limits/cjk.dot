// 中文标签:一个名字占两格,撞上线条怎么办
graph cjk {
  "中文站名0" [pos="0,0"];
  "中文站名1" [pos="3,2"];
  "中文站名2" [pos="6,0"];
  "中文站名3" [pos="9,2"];
  "中文站名4" [pos="12,0"];
  "中文站名5" [pos="15,2"];
  "中文站名6" [pos="18,0"];
  "中文站名7" [pos="21,2"];
  "中文站名0" -- "中文站名1";
  "中文站名1" -- "中文站名2";
  "中文站名2" -- "中文站名3";
  "中文站名3" -- "中文站名4";
  "中文站名4" -- "中文站名5";
  "中文站名5" -- "中文站名6";
  "中文站名6" -- "中文站名7";
}
