// 八个节点排在同一条线上:线会从中间那些节点身上穿过去
graph collinear {
  "p0" [pos="0,0"];
  "p1" [pos="10,0"];
  "p2" [pos="20,0"];
  "p3" [pos="30,0"];
  "p4" [pos="40,0"];
  "p5" [pos="50,0"];
  "p6" [pos="60,0"];
  "p7" [pos="70,0"];
  "p0" -- "p1";
  "p1" -- "p2";
  "p2" -- "p3";
  "p3" -- "p4";
  "p4" -- "p5";
  "p5" -- "p6";
  "p6" -- "p7";
}
